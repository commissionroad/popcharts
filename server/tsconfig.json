{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "outDir": "./dist",
    // Server code imports the repo's single env-file parse body from
    // ../scripts/shared/env by relative path (scripts/ is not a workspace
    // package, and its node --experimental-strip-types runtime cannot load TS
    // out of node_modules). rootDir has to sit above both trees or tsc rejects
    // that import with TS6059. Nothing emits from this config — the server
    // builds with `bun build` and typechecks with `tsc --noEmit`.
    "rootDir": "..",
    "declaration": true,
    "types": ["bun"],
    "baseUrl": "./src",
    "paths": {
      "src/*": ["./*"]
    }
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}

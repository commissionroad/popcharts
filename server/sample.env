# Pop Charts server local environment.
#
# Copy this file to server/.env for local API/indexer development.

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/popcharts
PORT=3001
NETWORK=arcTestnet

# ECS/RDS deployments can use these component values instead of DATABASE_URL.
# DATABASE_HOST=popcharts.cluster-abc123.us-east-1.rds.amazonaws.com
# DATABASE_PORT=5432
# DATABASE_NAME=popcharts
# DATABASE_USER=popcharts
# DATABASE_PASSWORD=...
# DATABASE_SSL=true

# Arc Testnet defaults. Set NETWORK=local and LOCAL_* values for local Hardhat.
ARC_TESTNET_RPC_HTTP_URL=https://rpc.testnet.arc.network
ARC_TESTNET_RPC_WSS_URL=wss://rpc.testnet.arc.network
ARC_TESTNET_PREGRAD_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
ARC_TESTNET_PREGRAD_MANAGER_DEPLOY_BLOCK=0

# Server-side key that signs the creator-bound authorization a publisher spends
# on createMarket. Local dev (NETWORK=local) falls back to a built-in dev
# account. Every other network must set this: without it the server mints no
# authorization, and createMarket reverts for any sender that is not a
# trusted creator.
POPCHARTS_MARKET_CREATION_AUTHORIZER_PRIVATE_KEY=

# Local development only. Enables /dev endpoints when NETWORK=local.
POPCHARTS_DEV_TOOLS_ENABLED=false

# Optional ECS/Kubernetes-style liveness marker for the indexer process.
HEALTH_CHECK_FILE=/tmp/popcharts-indexer-healthy

# AI review defaults to the Anthropic API over evidence the service collects
# first. The service searches the web itself, then hands the model that
# evidence with no tools of its own. This path needs ANTHROPIC_API_KEY and
# TAVILY_API_KEY.
#
# The local stack does not use these defaults. It sets the provider to
# claude-cli, the evidence mode to native, and the search provider to
# duckduckgo, so a local stack needs no API keys. See
# scripts/shared/aiReview/buildAiReviewEnv.ts.
AI_REVIEW_PORT=3002
AI_REVIEW_PROVIDER=anthropic
# Where a review's evidence comes from: precollected or native. precollected
# gathers the evidence first and gives every provider the same array.
AI_REVIEW_EVIDENCE_MODE=precollected
# Which engine backs the precollected path: tavily or duckduckgo. tavily
# returns page text with each hit and needs TAVILY_API_KEY. duckduckgo is the
# key-free fallback.
AI_REVIEW_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# The API's in-process draft-review loop ignores AI_REVIEW_PROVIDER and
# defaults to the deterministic heuristic; set this to a provider name to
# gate drafts with a model. The local stack sets claude-cli at the stack
# seam (scripts/shared/env/buildLocalServerEnv.ts).
# POPCHARTS_DRAFT_REVIEW_PROVIDER=
# Set AI_REVIEW_PROVIDER=codex-cli or claude-cli to review with a headless
# coding CLI on the host instead. Each model is pinned because the CLI
# otherwise resolves one from a server-side catalogue.
AI_REVIEW_CODEX_CLI_COMMAND=codex
AI_REVIEW_CODEX_CLI_MODEL=gpt-5.6-luna
AI_REVIEW_CLAUDE_CLI_COMMAND=claude
AI_REVIEW_CLAUDE_CLI_MODEL=sonnet
AI_REVIEW_OLLAMA_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=http://127.0.0.1:11434
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_REVIEW_ANTHROPIC_MODEL=claude-sonnet-4-6
AI_REVIEW_ANTHROPIC_MAX_OUTPUT_TOKENS=2048
AI_REVIEW_ANTHROPIC_MAX_WEB_SEARCHES=3
AI_REVIEW_ANTHROPIC_MAX_WEB_FETCHES=2
AI_REVIEW_ANTHROPIC_WEB_FETCH_MAX_CONTENT_TOKENS=12000
AI_REVIEW_INTERNET_ACCESS=search
AI_REVIEW_MAX_SEARCH_RESULTS=5
AI_REVIEW_FETCH_SEARCH_RESULTS=false
# Per-review provider-call ceiling. The codex-cli and claude-cli providers
# spawn a headless coding CLI and need minutes, not seconds. The API and
# heuristic paths return well inside this ceiling.
AI_REVIEW_TIMEOUT_MS=300000
# Terminal draft verdicts from a model provider need an agreeing rerun (ADR 0019).
POPCHARTS_DRAFT_REVIEW_CORROBORATION=true

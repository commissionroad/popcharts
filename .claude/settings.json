{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types \"$CLAUDE_PROJECT_DIR/scripts/guard-stack-control.ts\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "( \"$CLAUDE_PROJECT_DIR/scripts/prune-branches\" --auto >/dev/null 2>&1 & )",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
